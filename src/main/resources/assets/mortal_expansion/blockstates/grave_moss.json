{
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss" } },
    { "when": { "east": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss", "y": 90, "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss", "y": 270, "uvlock": true } },
    { "when": { "up": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss", "x": 270, "uvlock": true } },
    { "when": { "down": "true" }, "apply": { "model": "mortal_expansion:block/grave_moss", "x": 90, "uvlock": true } }
  ]
}
