{
  "schemaVersion": 1,
  "id": "mortal_expansion",
  "version": "${version}",
  "name": "Mortal Expansion (Fabric development)",
  "description": "Fabric gameplay port in progress: persistent Haunt, live EMF readers, native terrain/trees/ore/cemeteries, book research, generators, tanks/pipes, purification and altars. Custom mobs, spectral equipment powers and travel remain pending.",
  "authors": [
    "Howierux"
  ],
  "contact": {
    "homepage": "https://github.com/Howierux/mortal_expansion",
    "sources": "https://github.com/Howierux/mortal_expansion/tree/fabric-dev",
    "issues": "https://github.com/Howierux/mortal_expansion/issues"
  },
  "license": "All Rights Reserved",
  "icon": "assets/mortal_expansion/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "com.howierux.mortalexpansion.MortalExpansionFabric",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "com.howierux.mortalexpansion.client.MortalExpansionFabricClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "com.howierux.mortalexpansion.client.MortalExpansionFabricDataGenerator",
        "adapter": "kotlin"
      }
    ],
    "terrablender": [
      "com.howierux.mortalexpansion.worldgen.TerrainRuntime"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.17",
    "fabric-language-kotlin": "*",
    "team_reborn_energy": ">=4.1.0",
    "terrablender": ">=4.1.0.8"
  },
  "mixins": [
    "mortal_expansion.mixins.json"
  ]
}
